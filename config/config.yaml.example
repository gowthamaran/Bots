api:
  gamma_base_url: "https://gamma-api.polymarket.com"
  clob_base_url: "https://clob.polymarket.com"
  chain_id: 137
  request_timeout_seconds: 10
  max_retries: 4

strategy:
  # paper logs what the bot would do; live sends orders via py-clob-client-v2.
  mode: "paper"
  loop_interval_seconds: 60
  target_spread_cents: 1.0
  min_estimated_daily_yield_pct: 0.10
  max_order_size_usdc: 100
  auto_discover: true
  markets: []
  boundary_buffer_cents: 1.0
  cancel_stale_orders: true

filters:
  min_midpoint: 0.10
  max_midpoint: 0.90
  min_daily_rewards_usdc: 10
  min_liquidity_usdc: 1000
  min_volume_24h_usdc: 1000
  min_hours_to_resolution: 24
  max_hours_to_resolution: 1440
  allowed_topics: []
  blocked_keywords: ["lawsuit", "court", "delist", "bankruptcy"]
  allow_sports: false

risk:
  max_total_capital_usdc: 1000
  max_market_capital_usdc: 200
  max_inventory_delta_usdc: 75
  max_live_orders_per_market: 4
  circuit_breaker_consecutive_errors: 5
  pause_on_boundary_cross: true

telegram:
  enabled: false
  chat_id: null
